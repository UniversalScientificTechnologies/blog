{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Jekyll: serve",
            "detail": "Spustí blog na http://127.0.0.1:3000 s live reloadem",
            "type": "shell",
            "command": "bundle exec jekyll serve --port 3000 --livereload --livereload-port 3001",
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "owner": "jekyll",
                "pattern": {
                    "regexp": "^\\s*(?:Liquid Exception|Error):\\s+(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Generating\\.\\.\\.|Regenerating:",
                    "endsPattern": "Server running\\.\\.\\.|\\.\\.\\.done in"
                }
            }
        },
        {
            "label": "Jekyll: build",
            "detail": "Jednorázově vygeneruje web do _site",
            "type": "shell",
            "command": "bundle exec jekyll build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Jekyll: install dependencies",
            "detail": "Nainstaluje gemy z Gemfile",
            "type": "shell",
            "command": "bundle install",
            "problemMatcher": []
        }
    ]
}
